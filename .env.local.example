# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real secrets.
# See SETUP_META.md for how to obtain each value.

# App ID / App Secret from your Meta app's dashboard (Settings > Basic).
META_APP_ID=
META_APP_SECRET=

# Graph API version to call. Update if Meta deprecates this version.
META_GRAPH_API_VERSION=v21.0

# Any random string you choose. Meta sends it back during webhook
# verification (hub.verify_token) — must match exactly what you enter
# in the Meta app's Webhooks product configuration.
META_WEBHOOK_VERIFY_TOKEN=

# Public base URL of this app, no trailing slash. Meta requires HTTPS
# for OAuth redirect and webhook callback URLs, so local development
# needs a tunnel (e.g. ngrok) — see SETUP_META.md.
#   OAuth redirect URI = ${NEXT_PUBLIC_APP_URL}/api/auth/meta/callback
#   Webhook callback URL = ${NEXT_PUBLIC_APP_URL}/api/webhooks/meta
NEXT_PUBLIC_APP_URL=http://localhost:3000
